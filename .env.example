# Copy to .env and fill in real values for local dev.
# Valt's detection engine reads this file (NEVER your real .env) to map
# environment variables to third-party services.

# Server
PORT=3000

# Stripe (Valt will spin up a Stripe twin against this app)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Postgres (Valt will spin up a sidecar)
DATABASE_URL=postgresql://user:pass@localhost:5432/demo
